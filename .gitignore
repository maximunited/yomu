# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.nyc_output
/tests/coverage

# jest artifacts
jest-results.json
jest-out.txt

# Playwright
test-results/
playwright-report/
playwright/.cache/
playwright/.reports/
playwright/.clerk/

# next.js
.next/
out/

# next lint cache
.eslintcache

# production
/build

# misc
.DS_Store
Thumbs.db
desktop.ini
.node_repl_history
*.tgz
.cache/
.history/
.idea/
.vscode/
*.pem
.dockerignore
.dockerignore.local
docker-compose.override.yml
compose.override.yml

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env*.local
.env.production
.env.vercel
.envrc
.direnv/
# Allow .env.example as template
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# prisma local databases
prisma/dev.db
prisma/dev.db-journal
prisma/*.sqlite
prisma/*.sqlite-journal

# security audit reports
audit-report.json
vulnerability-report.json
loyalty-url-status.json

# Claude Code local settings (user-specific)
.claude/

# Local git worktrees
.worktrees/

.vercel
.env*.local

.vercel

# Local git worktrees
.worktrees/

# Admin ops runtime artifacts (URL audit last report)
.data/

# OpenWolf — allowlist protocol; block runtime/telemetry
.wolf/*
!.wolf/OPENWOLF.md
!.wolf/identity.md
!.wolf/config.json
!.wolf/cron-manifest.json
!.wolf/reframe-frameworks.md
!.wolf/hooks/
.wolf/hooks/_session.json
!.wolf/hooks/*.js
!.wolf/hooks/package.json

# CodeGraph — only the nested ignore file
.codegraph/*
!.codegraph/.gitignore

