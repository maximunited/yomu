# =============================================================================
# YomU Environment Variables Template
# =============================================================================
# Copy this file to .env and update with your actual values
# Never commit your .env file to Git!

# =============================================================================
# DATABASE (PostgreSQL Required)
# =============================================================================

# IMPORTANT: This project uses PostgreSQL only (SQLite is NOT supported)
# Choose ONE of the following options:

# Option 1: Docker Compose (Recommended for local development)
# Use if running: ./scripts/docker-setup.sh start-dev
DATABASE_URL=postgresql://yomu:yomu@localhost:5432/yomu

# Option 2: Vercel Postgres (Development Database)
# Get from: vercel env pull .env
# DATABASE_URL=postgres://default:xxxxx@xxxxx.postgres.vercel-storage.com:5432/verceldb?sslmode=require

# Option 3: Manual PostgreSQL Installation
# Update with your local PostgreSQL credentials
# DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/yomu

# =============================================================================
# CLERK AUTHENTICATION
# =============================================================================

# Get from: https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-key-here
CLERK_SECRET_KEY=sk_test_your-key-here

# Webhook signing secret (from Clerk Dashboard → Webhooks)
CLERK_WEBHOOK_SIGNING_SECRET=whsec_your-secret-here

# Auth route configuration
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# E2E (Playwright + @clerk/testing) - dedicated test user (+clerk_test) + disposable DB only
# Required for authenticated specs only (not used by PR CI chromium smoke)
# E2E_CLERK_USER_EMAIL=e2e+clerk_test@example.com
# E2E_CLERK_USER_PASSWORD=optional-if-user-already-exists
# Required before any e2e Prisma write (DOB upsert + golden-path brands):
# E2E_ALLOW_DB_SEED=1
# Only for a disposable remote DB (default allowlist is localhost / docker hosts):
# E2E_ALLOW_REMOTE_DB=1
# Optional alias if you prefer not to rely on NEXT_PUBLIC_*:
# CLERK_PUBLISHABLE_KEY=pk_test_your-key-here
# Nightly multi-browser under CI=true:
# E2E_FULL_BROWSERS=1

# =============================================================================
# NOTES
# =============================================================================
# See QUICKSTART.md for step-by-step setup instructions
# See CLAUDE.md for detailed PostgreSQL setup options
# See docs/DATABASE_MIGRATION.md for database architecture details
